<Page
    x:Class="JakeyTTS.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">

            <!-- App Icon & Title -->
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE767;" FontSize="72" Foreground="{ThemeResource SystemAccentColor}"/>
                <TextBlock Text="JakeyTTS" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- State 1: Not Configured -->
            <Button x:Name="ConfigureBtn" Click="ConfigureBtn_Click" 
                    Visibility="Collapsed" Padding="30,12" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Setting"/>
                    <TextBlock Text="Configure App"/>
                </StackPanel>
            </Button>

            <!-- State 2: Configured but Stopped -->
            <Button x:Name="StartBtn" Click="ServiceToggle_Click" 
                    Visibility="Collapsed" Padding="30,12" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Play"/>
                    <TextBlock Text="Start Service"/>
                </StackPanel>
            </Button>

            <!-- State 3: Running -->
            <Button x:Name="StopBtn" Click="ServiceToggle_Click" 
                    Visibility="Collapsed" Padding="30,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Stop"/>
                    <TextBlock Text="Stop Service"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Page>