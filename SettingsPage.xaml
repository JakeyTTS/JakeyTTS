<Page
    x:Class="JakeyTTS.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="40" Spacing="20" MaxWidth="600" HorizontalAlignment="Left">
        <!-- Appearance Section -->
        <StackPanel Spacing="10">
            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <RadioButtons x:Name="ThemeSelector" SelectionChanged="ThemeSelector_SelectionChanged">
                <RadioButton Content="Use System Setting" Tag="0"/>
                <RadioButton Content="Light" Tag="1"/>
                <RadioButton Content="Dark" Tag="2"/>
            </RadioButtons>
        </StackPanel>

        <MenuFlyoutSeparator/>

        <!-- About Section -->
        <StackPanel Spacing="10">
            <TextBlock Text="About JakeyTTS" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="JakeyTTS Voice Engine" FontWeight="Bold"/>
                    <TextBlock Text="Version 1.0.42"/>
                    <TextBlock Text="Powered by Kokoro v1.0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <MenuFlyoutSeparator/>

        <!-- Danger Zone Section -->
        <StackPanel Spacing="10">
            <TextBlock Text="Danger Zone" Foreground="OrangeRed" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock Text="This will remove all Twitch tokens, commands, and custom rewards. This action cannot be undone." 
                       TextWrapping="Wrap" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

            <Button x:Name="ResetBtn" Content="Restore Factory Defaults" 
                    Click="ResetBtn_Click" Foreground="White" Background="DarkRed"/>
        </StackPanel>

        <!-- Confirmation Dialog -->
        <ContentDialog x:Name="ConfirmResetDialog"
                       Title="Reset Everything?"
                       PrimaryButtonText="Yes, Reset"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock Text="Are you absolutely sure? You will need to re-link your Twitch accounts and re-configure all your commands." 
                       TextWrapping="Wrap"/>
        </ContentDialog>
    </StackPanel>
</Page>