<Page
    x:Class="JakeyTTS.MelodyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:JakeyTTS.Core.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:MelodyToPointCollectionConverter x:Key="MelodyPreviewConverter"/>
        <conv:PointCountConverter x:Key="PointCountTextConverter"/>
        <conv:TagPreviewConverter x:Key="TagPreviewConverter"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,25">
            <TextBlock Text="Melody Library" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Click="Create_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="New Melody"/>
                </StackPanel>
            </Button>

            <Button Click="Import_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Import"/>
                    <TextBlock Text="Import JSON"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search by name..." 
                        QueryIcon="Find" TextChanged="SearchBox_TextChanged" Margin="0,0,0,25"/>

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="MelodyCardsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="310"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Margin="0,0,15,15" Padding="16" Width="290">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource TagPreviewConverter}}" Foreground="MediumOrchid" FontSize="12" FontWeight="SemiBold" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding IsEnabled, Mode=TwoWay}" Toggled="OnIsEnabledToggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="60" Background="{ThemeResource SystemControlBackgroundAltMediumBrush}" CornerRadius="4" Padding="10">
                                    <Polyline Points="{Binding Points, Converter={StaticResource MelodyPreviewConverter}}" Stroke="MediumOrchid" StrokeThickness="2" Stretch="Fill"/>
                                </Border>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Edit" Click="Edit_Click" Tag="{Binding}" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1" Content="Preview" Click="PlayPreview_Click" Tag="{Binding}" HorizontalAlignment="Stretch"/>

                                    <Button Grid.Column="2" Click="Export_Click" Tag="{Binding}" Background="Transparent" ToolTipService.ToolTip="Export JSON">
                                        <SymbolIcon Symbol="Share"/>
                                    </Button>

                                    <Button Grid.Column="3" Click="Delete_Click" Tag="{Binding}" Foreground="OrangeRed" Background="Transparent" ToolTipService.ToolTip="Delete">
                                        <SymbolIcon Symbol="Delete"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
