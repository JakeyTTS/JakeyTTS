<Page
    x:Class="JakeyTTS.MelodyEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:JakeyTTS"
    mc:Ignorable="d">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header con Botón de Preview -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="15">
                <Button Click="Back_Click" Style="{StaticResource NavigationBackButtonNormalStyle}"/>
                <TextBlock x:Name="TitleText" Text="Melody Editor" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <Button Grid.Column="1" Click="Preview_Click" Style="{StaticResource AccentButtonStyle}" Padding="15,5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Play"/>
                    <TextBlock Text="Test Melody"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Contenido Principal (Dos Columnas) -->
        <Grid Grid.Row="1" ColumnSpacing="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Padding="0,0,10,0">
                    <TextBox x:Name="NameInput" Header="Melody Name" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Point Data" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <ItemsControl x:Name="PointsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <NumberBox Header="Time" Value="{Binding TimePct, Mode=TwoWay}" SmallChange="0.05" Minimum="0" Maximum="1" ValueChanged="NumberBox_ValueChanged" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox Grid.Column="1" Header="Pitch" Value="{Binding Pitch, Mode=TwoWay}" SmallChange="0.1" Minimum="0.5" Maximum="2" ValueChanged="NumberBox_ValueChanged" SpinButtonPlacementMode="Compact"/>
                                        <Button Grid.Column="2" Click="DeletePoint_Click" Tag="{Binding}" VerticalAlignment="Bottom" Foreground="OrangeRed">
                                            <FontIcon Glyph="&#xE10A;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Add New Point" Click="AddPoint_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>

            <!-- COLUMNA DERECHA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Visual Preview (Click to add, Drag points to move)" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <Canvas x:Name="EditorCanvas" Background="Transparent" 
                            PointerPressed="Canvas_PointerPressed" SizeChanged="EditorCanvas_SizeChanged">
                        <Polyline x:Name="GraphLine" Stroke="MediumOrchid" StrokeThickness="4" StrokeLineJoin="Round"/>
                        <ItemsControl x:Name="VisualPointsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:DraggableDot PointerPressed="Point_PointerPressed"
                                                       PointerMoved="Point_PointerMoved"
                                                       PointerReleased="Point_PointerReleased"
                                                       PointerEntered="Point_PointerEntered"
                                                       PointerExited="Point_PointerExited"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
            <Button Content="Save Changes" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Width="150"/>
            <Button Content="Discard" Click="Back_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Page>