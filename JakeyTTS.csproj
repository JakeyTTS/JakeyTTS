<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>JakeyTTS</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>

		<ApplicationIcon>app.ico</ApplicationIcon>

		<Platforms>x64</Platforms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishProfile>win-x64.pubxml</PublishProfile>

		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>

		<Version>2.0.2</Version>
		<AssemblyVersion>2.0.2.0</AssemblyVersion>
		<FileVersion>2.0.2.0</FileVersion>
		<ApplicationDisplayVersion>2.0.2</ApplicationDisplayVersion>
		<ApplicationVersion>2.0.2.0</ApplicationVersion>


		<WindowsPackageType>None</WindowsPackageType>
		<WinUISDKReferences>true</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<WindowsAppRuntimeSelfContained>true</WindowsAppRuntimeSelfContained>
		<AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>

		<PublishTrimmed>false</PublishTrimmed>
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>

		<None Include="app.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>

		<Content Include="Assets\**\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
		<PackageReference Include="KokoroSharp" Version="0.6.7" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
		<PackageReference Include="System.Text.Json" Version="10.0.7" />
		<PackageReference Include="TwitchLib.EventSub.Websockets" Version="0.8.0" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="WinUI.TableView" Version="1.4.1" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="voices\**\*.npy" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="voices\**\*.json;voices\**\*.py" CopyToOutputDirectory="PreserveNewest" />
		<None Remove="MixVoices\MixedVoicesPage.xaml" />
		<None Remove="Plugins\PLuginsDocPage.xaml" />
		<None Remove="Plugins\PluginsPage.xaml" />
		<None Remove="Views\SoundEffectsPage.xaml" />
		<None Remove="UserActions\UserActionsPage.xaml" />
		<Content Include="assets\kokoro-v1.0.onnx" Condition="Exists('assets\kokoro-v1.0.onnx')" Link="kokoro-v1.0.onnx" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <Page Update="Views\SoundEffectsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Melodies\" />
	  <Folder Include="Twitch\" />
	</ItemGroup>

	<ItemGroup>
	  <Page Update="Plugins\PLuginsDocPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>

	<ItemGroup>
	  <Page Update="Plugins\PluginsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>

	<ItemGroup>
	  <Page Update="UserActions\UserActionsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>

	<ItemGroup>
	  <Page Update="MixVoices\MixedVoicesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>
</Project>