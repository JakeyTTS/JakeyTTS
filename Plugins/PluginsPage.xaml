<Page
    x:Class="JakeyTTS.Plugins.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JakeyTTS"
    xmlns:conv="using:JakeyTTS.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filter -->
            <RowDefinition Height="*"/>
            <!-- Cards -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="External Plugins &amp; Integrations" 
                           Style="{StaticResource TitleTextBlockStyle}" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"/>

                <HyperlinkButton Content="Learn how to build your own plugin" 
                                 Click="BuildPlugin_Click" 
                                 Margin="0,4,0,0"
                                 FontSize="14"/>
            </StackPanel>

            <TextBlock Grid.Column="1" 
                       Text="Server Status: Running on Port 8889" 
                       VerticalAlignment="Top" 
                       Opacity="0.5" 
                       Margin="0,10,0,0" 
                       TextWrapping="Wrap" 
                       MaxWidth="150"/>
        </Grid>

        <!-- NEW: SEARCH & FILTER BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" 
                     PlaceholderText="Search plugins by name..." 
                     TextChanged="SearchBox_TextChanged" 
                     Width="300" 
                     HorizontalAlignment="Left"/>

            <ComboBox x:Name="ScopeFilterBox" 
                      Grid.Column="1" 
                      PlaceholderText="Filter by scope" 
                      SelectionChanged="ScopeFilterBox_SelectionChanged" 
                      Width="180"
                      SelectedIndex="0">
                <x:String>All Scopes</x:String>
                <x:String>chat</x:String>
                <x:String>commands</x:String>
                <x:String>redeems</x:String>
                <x:String>bits</x:String>
                <x:String>subs</x:String>
                <x:String>test</x:String>
            </ComboBox>
        </Grid>

        <!-- PLUGIN CARDS -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="20">

                <!-- EMPTY STATE (Now binds to FilteredPlugins so it shows up if a search returns 0 results) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="40" Margin="0,40,0,0"
                            Visibility="{x:Bind FilteredPlugins.Count, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">

                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA86;" FontSize="56" Opacity="0.15" Margin="0,0,0,10"/>
                    <TextBlock Text="No plugins match your current filters." FontWeight="SemiBold" Opacity="0.8" FontSize="18" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="To add a plugin, start the external application (like the Discord Bot)." Opacity="0.6" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="If you already have a plugin running, please follow its specific installation and connection process through the plugin's app so it can register here." 
                               Opacity="0.5" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="450"/>
                </StackPanel>

                <!-- GRID OF PLUGINS (Now binds to FilteredPlugins) -->
                <GridView ItemsSource="{x:Bind FilteredPlugins, Mode=OneWay}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:PluginItem">
                            <Border Width="320" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,15,15">
                                <StackPanel Spacing="15">

                                    <!-- Top Header: Icon, Name, Version, Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon Setup -->
                                        <Grid Width="42" Height="42" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Top">

                                            <Image Source="{x:Bind IconBase64, Converter={StaticResource Base64ToImageConverter}, Mode=OneWay}" 
                                                   Stretch="Uniform" Margin="4"/>

                                            <!-- The puzzle icon will now show if IconBase64 is null OR "" -->
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA86;" FontSize="20" Opacity="0.2"
                                                      Visibility="{x:Bind IconBase64, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse, Mode=OneWay}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" 
                                                      IsOn="{Binding IsEnabled, Mode=TwoWay}" 
                                                      Toggled="PluginToggle_Toggled" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="Center"
                                                      OnContent="" OffContent="" MinWidth="0" Margin="0,0,-10,0"
                                                      ToolTipService.ToolTip="Allow Access"/>
                                    </Grid>

                                    <!-- Requested Scopes -->
                                    <StackPanel Spacing="8" Margin="0,5,0,5">
                                        <TextBlock Text="Requested Access:" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>

                                        <ItemsControl ItemsSource="{x:Bind Subscriptions, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="{ThemeResource SystemAccentColorDark2}" CornerRadius="4" Padding="6,2" Margin="0,0,5,5">
                                                        <TextBlock Text="{x:Bind}" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Footer Button -->
                                    <Button HorizontalAlignment="Stretch" Click="DeletePlugin_Click" Padding="8" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="14"/>
                                            <TextBlock Text="Revoke &amp; Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>