<Page
    x:Class="JakeyTTS.Plugins.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JakeyTTS.Core"
    xmlns:local="using:JakeyTTS"
    xmlns:conv="using:JakeyTTS.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="External Plugins &amp; Integrations" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Server Status: Running on Port 8889" Opacity="0.5" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <HyperlinkButton Grid.Column="1" Content="Build your own plugin" Click="BuildPlugin_Click" VerticalAlignment="Top"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">

                <Grid x:Name="FiltersGrid" Margin="0,0,0,10"
                      Visibility="{Binding IsBackendEmpty, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" PlaceholderText="Search plugins by name..." TextChanged="SearchBox_TextChanged" Width="300" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="ScopeFilterBox" Grid.Column="1" SelectionChanged="ScopeFilterBox_SelectionChanged" Width="180" SelectedIndex="0" Margin="10,0,0,0">
                        <x:String>All Scopes</x:String>
                        <x:String>chat</x:String>
                        <x:String>commands</x:String>
                        <x:String>redeems</x:String>
                        <x:String>bits</x:String>
                        <x:String>subs</x:String>
                        <x:String>test</x:String>
                    </ComboBox>
                </Grid>

                <StackPanel HorizontalAlignment="Center" Spacing="15" Padding="20,60"
                            Visibility="{Binding ShowInstructions, Converter={StaticResource NullToVisibilityConverter}}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA86;" FontSize="68" Opacity="0.15" Margin="0,0,0,10"/>
                    <TextBlock Text="No Plugins Found" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center"/>
                    <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="30" MaxWidth="550">
                        <StackPanel Spacing="10">
                            <TextBlock Text="1. Start an external plugin (e.g. Discord Bridge)"/>
                            <TextBlock Text="2. Ensure it connects to ws://localhost:8889"/>
                            <TextBlock Text="3. Authorize it here when it appears"/>
                        </StackPanel>
                    </Border>
                    <HyperlinkButton Content="Follow the Plugin Development Guide" Click="BuildPlugin_Click" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Spacing="10" Padding="0,60"
                            Visibility="{Binding ShowNoResults, Converter={StaticResource NullToVisibilityConverter}}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE11A;" FontSize="48" Opacity="0.2"/>
                    <TextBlock Text="No results match your search" FontSize="20" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Center"/>
                </StackPanel>

                <GridView ItemsSource="{Binding FilteredPlugins, Mode=OneWay}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:PluginItem">
                            <Border Width="340" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,15,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Spacing="14" VerticalAlignment="Top">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="42" Height="42" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                <Image Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}" Stretch="Uniform" Margin="4"/>
                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA86;" FontSize="20" Opacity="0.2"
                                                          Visibility="{Binding IconBase64, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Version}" Opacity="0.5" FontSize="11"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" IsOn="{Binding IsEnabled, Mode=TwoWay}" Toggled="PluginToggle_Toggled" OnContent="" OffContent="" MinWidth="0"/>
                                        </Grid>

                                        <StackPanel Background="{ThemeResource LayerFillColorAltBrush}" Padding="12" CornerRadius="6" Spacing="10"
                                                    Visibility="{Binding ExecutablePath, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="Local Runtime Properties:" FontSize="11" FontWeight="Bold" Opacity="0.7"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Content="Run hidden in background" 
                                                          IsChecked="{Binding LaunchInvisible}" 
                                                          Checked="InvisibleLaunch_Checked" 
                                                          Unchecked="InvisibleLaunch_Checked" 
                                                          FontSize="11" VerticalAlignment="Center"/>

                                                <Button Grid.Column="1" Click="LaunchManualProgram_Click" 
                                                        Content="▶️ Run Module" Padding="12,4,12,4" 
                                                        Style="{StaticResource AccentButtonStyle}" FontSize="12" 
                                                        FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Authorized Subscription Scopes:" FontSize="11" FontWeight="Bold" Opacity="0.6"/>

                                            <ItemsControl ItemsSource="{Binding Subscriptions}">
                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource SystemAccentColorLight3}" 
                                                                BorderBrush="{ThemeResource SystemAccentColorLight1}" 
                                                                BorderThickness="1" CornerRadius="6" 
                                                                Padding="10,0,14,0" Margin="0,0,6,6">
                                                            <TextBlock Text="{Binding}" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource SystemAccentColorDark3}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <HyperlinkButton Grid.Row="1" Click="DeletePlugin_Click" HorizontalAlignment="Center" Margin="0,16,0,0" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            <TextBlock Text="Remove Integration" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

