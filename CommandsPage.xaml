<Page
    x:Class="JakeyTTS.CommandsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Row for Info Panel -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scripting Info Panel -->
        <Expander Grid.Row="1" Header="Scripting &amp; Tag Guide" HorizontalAlignment="Stretch" Margin="0,0,0,20">
            <StackPanel Padding="16" Spacing="8">
                <TextBlock Text="Dynamic Tags:" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="• {user} - Name of the chatter" FontSize="12"/>
                <TextBlock Text="• {target} - First word after command" FontSize="12"/>
                <TextBlock Text="• {1}, {2}... - Positional arguments" FontSize="12"/>
                <TextBlock Text="• {random:1-100} - Random number" FontSize="12"/>
                <TextBlock Text="• [choose: Yes | No] - Random choice" FontSize="12"/>
                <TextBlock Text="• [pause: 500] - Pause TTS (ms)" FontSize="12" Foreground="SkyBlue"/>
                <TextBlock Text="• [speed: 1.2] - Change voice speed" FontSize="12" Foreground="SkyBlue"/>
            </StackPanel>
        </Expander>

        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <controls:DataGrid x:Name="CommandsGrid" 
                               AutoGenerateColumns="False" 
                               GridLinesVisibility="Horizontal"
                               SelectionMode="Single"
                               RowHeight="48">
                <controls:DataGrid.Columns>
                    <controls:DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, Mode=TwoWay}" Width="50"/>
                    <controls:DataGridTextColumn Header="Trigger" Binding="{Binding Trigger, Mode=TwoWay}" Width="150"/>
                    <controls:DataGridTextColumn Header="Response" Binding="{Binding Response, Mode=TwoWay}" Width="*"/>
                    <controls:DataGridCheckBoxColumn Header="Speak" Binding="{Binding ShouldSpeak, Mode=TwoWay}" Width="65"/>
                    <controls:DataGridCheckBoxColumn Header="Chat" Binding="{Binding ShouldReplyInChat, Mode=TwoWay}" Width="65"/>
                    <controls:DataGridCheckBoxColumn Header="Bot" Binding="{Binding ReplyAsBot, Mode=TwoWay}" Width="65"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
            <Button Click="Add_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="New Command"/>
                </StackPanel>
            </Button>
            <Button Click="Delete_Click" Foreground="Red">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete"/>
                    <TextBlock Text="Delete Selected"/>
                </StackPanel>
            </Button>
            <Button Content="Save All" Click="Save_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Page>