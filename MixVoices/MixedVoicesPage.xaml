<Page
    x:Class="JakeyTTS.MixVoices.MixedVoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:JakeyTTS" 
    xmlns:conv="using:JakeyTTS.Converters" 
    mc:Ignorable="d" x:Name="RootPage">

    <Page.Resources>
        <conv:PointCountConverterVoice x:Key="PointCountConverter"/>
        <conv:PercentConverter x:Key="PercentConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:TagVoicePreviewConverter x:Key="TagPreviewConverter"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
                <TextBlock Text="Mixed Voices Library" Style="{StaticResource TitleTextBlockStyle}"/>
                <Button Click="AddMix_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add New"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <GridView x:Name="MixGrid" Grid.Row="1" SelectionMode="Single" Padding="0,0,0,20">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MixedVoiceItem">
                        <Border Width="200" Height="180" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <FontIcon Glyph="&#xE77B;" Foreground="MediumOrchid" FontSize="28" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="Bold" 
                                           HorizontalAlignment="Center" TextAlignment="Center" MaxLines="1" TextWrapping="NoWrap"/>
                                <TextBlock Grid.Row="2" Text="{x:Bind Name, Mode=OneWay, Converter={StaticResource TagPreviewConverter}}" 
                                           Foreground="MediumOrchid" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                                <ToggleSwitch Grid.Row="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" 
                                              OnContent="Active" OffContent="Disabled" 
                                              FontSize="11" MinWidth="0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <Button Grid.Row="5" Click="DeleteMix_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="8,4">
                                    <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" 
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Padding="24"
                            Visibility="{Binding SelectedItem, ElementName=MixGrid, Converter={StaticResource NullToVisibilityConverter}}">
                    <Viewbox Width="48" Height="48" Opacity="0.2">
                        <SymbolIcon Symbol="Edit"/>
                    </Viewbox>
                    <TextBlock Text="Select a voice to modify its components." Opacity="0.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="250"/>
                </StackPanel>

                <Grid Visibility="{Binding SelectedItem, ElementName=MixGrid, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="24,24,24,10">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Mix Editor" FontWeight="Black" FontSize="22"/>
                            <TextBox Header="Internal Name" Text="{Binding SelectedItem.Name, ElementName=MixGrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid>
                                <TextBlock Text="Voice Components" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Click="AddComponent_Click" Style="{StaticResource DefaultButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                        <TextBlock Text="Add"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="ComponentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VoiceWeight">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,0,12" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Header="Language" HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding ElementName=RootPage, Path=Languages}"
                                                              Loaded="LanguageBox_Loaded"
                                                              SelectionChanged="ComponentLanguage_Changed"/>

                                                    <ComboBox Grid.Column="1" Header="Voice" HorizontalAlignment="Stretch"
                                                              SelectedItem="{x:Bind VoiceName, Mode=TwoWay}"/>

                                                    <Button Grid.Column="2" VerticalAlignment="Bottom" Click="RemoveComponent_Click" Background="Transparent" BorderThickness="0">
                                                        <FontIcon Glyph="&#xE711;" Foreground="Red" FontSize="14"/>
                                                    </Button>
                                                </Grid>

                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="Influence" FontSize="12" Opacity="0.8"/>
                                                        <TextBlock Text="{x:Bind Weight, Mode=OneWay, Converter={StaticResource PercentConverter}}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold"/>
                                                    </Grid>
                                                    <Slider Value="{x:Bind Weight, Mode=TwoWay}" Minimum="0" Maximum="1" StepFrequency="0.01" SmallChange="0.01" 
                                                            ValueChanged="WeightSlider_ValueChanged"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                            Padding="24" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Preview" Click="TestMix_Click" HorizontalAlignment="Stretch" Height="40"/>
                            <Button x:Name="SaveBtn" Grid.Column="1" Content="Save Mix" Click="Save_Click" 
                                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>