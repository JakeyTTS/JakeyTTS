<Page
    x:Class="JakeyTTS.KeybindsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Margin="40" Spacing="20" MaxWidth="750" HorizontalAlignment="Left">
        <TextBlock Text="Global Hotkeys" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="Supports combinations (Ctrl, Shift, Alt). These work even when the app is in the background." 
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="Gray"/>

        <Border Padding="20" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="16">

                <!-- Action: Toggle Service -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Start / Stop Service" FontWeight="Bold"/>
                        <TextBlock Text="Connects or disconnects the bot from Twitch" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <Button x:Name="BtnToggle" Grid.Column="1" Content="None" Click="Record_Click" Width="200" Height="40" FontFamily="Consolas"/>
                    <Button Grid.Column="2" Click="Reset_Click" Tag="Toggle" Margin="8,0,0,0" ToolTipService.ToolTip="Clear Keybind">
                        <SymbolIcon Symbol="Clear"/>
                    </Button>
                </Grid>

                <MenuFlyoutSeparator/>

                <!-- Action: Stop Audio -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Stop Current Audio" FontWeight="Bold"/>
                        <TextBlock Text="Immediately silences the bot" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <Button x:Name="BtnStop" Grid.Column="1" Content="None" Click="Record_Click" Width="200" Height="40" FontFamily="Consolas"/>
                    <Button Grid.Column="2" Click="Reset_Click" Tag="Stop" Margin="8,0,0,0">
                        <SymbolIcon Symbol="Clear"/>
                    </Button>
                </Grid>

                <MenuFlyoutSeparator/>

                <!-- Action: Replay Last -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Replay Last Message" FontWeight="Bold"/>
                        <TextBlock Text="Plays the last message in history again" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <Button x:Name="BtnReplay" Grid.Column="1" Content="None" Click="Record_Click" Width="200" Height="40" FontFamily="Consolas"/>
                    <Button Grid.Column="2" Click="Reset_Click" Tag="Replay" Margin="8,0,0,0">
                        <SymbolIcon Symbol="Clear"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock Text="Changes are saved and applied automatically" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
            <Button Content="Force Save &amp; Sync" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Width="200"/>
        </StackPanel>
    </StackPanel>
</Page>