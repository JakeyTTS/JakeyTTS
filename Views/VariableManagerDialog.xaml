<ContentDialog
    x:Class="JakeyTTS.Views.VariableManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JakeyTTS.Core"
    xmlns:conv="using:JakeyTTS.Core.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Manage Global Variables"
    PrimaryButtonText="Close"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonText="">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer Margin="-24,-24,-24,-24" Padding="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Width="750">

            <InfoBar IsOpen="True" Severity="Informational" Title="How to use variables" IsClosable="False">
                <InfoBar.Message>
                    To insert a variable into a TTS or chat response, use the format {global:VariableName} or {local:VariableName} for non-list variables. For list variables, you can pick a random item by using {global:ListName:random} or {local:ListName:random}.
                </InfoBar.Message>
            </InfoBar>

            <!-- SCALARS -->
            <StackPanel Spacing="12">
                <TextBlock Text="Scalars (Numbers/Text)" FontWeight="SemiBold" FontSize="18"/>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Store.Scalars, Mode=OneWay}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StringPair">
                                    <Grid Margin="16,12,16,0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="Key" Text="{Binding Key, Mode=TwoWay}" Grid.Column="0"/>
                                        <TextBox Header="Value (Text)" Text="{Binding Value, Mode=TwoWay}" Grid.Column="1" Visibility="{Binding TextVisibility, Mode=OneWay}"/>
                                        <TextBox Header="Value (Number)" Text="{Binding Value, Mode=TwoWay}" Grid.Column="1" Visibility="{Binding NumberVisibility, Mode=OneWay}"/>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                            <CheckBox Content="Is Number" IsChecked="{Binding IsNumber, Mode=TwoWay}" Margin="0,0,8,0"/>
                                            <Button Background="Transparent" Click="DeleteScalar_Click" ToolTipService.ToolTip="Remove Variable">
                                                <SymbolIcon Symbol="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="AddScalar_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add"/>
                                        <TextBlock Text="Add Scalar Variable"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="AddNumber_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add"/>
                                        <TextBlock Text="Add Number Variable"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- LISTS -->
            <StackPanel Spacing="12">
                <TextBlock Text="Lists (Arrays/Quotes)" FontWeight="SemiBold" FontSize="18"/>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Store.Lists, Mode=OneWay}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StringListPair">
                                    <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,16,16,16">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- List Header -->
                                            <TextBox Header="List Name" Text="{x:Bind Key, Mode=TwoWay}" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
                                                <Button Content="Clear" Click="ClearList_Click"/>
                                                <Button Background="Transparent" Click="DeleteList_Click" ToolTipService.ToolTip="Delete List">
                                                    <SymbolIcon Symbol="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- List Items and Add -->
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <ItemsControl ItemsSource="{x:Bind Values, Mode=OneWay}" Grid.Column="0" Margin="0,0,16,0" MaxHeight="150">
                                                    <ItemsControl.Template>
                                                        <ControlTemplate>
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </ControlTemplate>
                                                    </ItemsControl.Template>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding}" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                <Button Grid.Column="1" Background="Transparent" Click="RemoveItemFromList_Click" DataContext="{Binding}">
                                                                    <SymbolIcon Symbol="Cancel" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12" CornerRadius="4" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <TextBlock Text="Add New Item" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBox x:Name="NewItemTextBox" PlaceholderText="Item Text..." AcceptsReturn="True" MaxHeight="80"/>
                                                    <Button Content="Add to List" Style="{StaticResource AccentButtonStyle}" Click="AddItemToList_Click" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Border Padding="16">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddList_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Add"/>
                                    <TextBlock Text="Add List Variable"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
