<Page
    x:Class="JakeyTTS.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CriticalButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <!-- Agregamos el ScrollViewer como contenedor raíz -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="40" Spacing="25" MaxWidth="700" HorizontalAlignment="Left">

            <!-- Appearance Section -->
            <StackPanel Spacing="10">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                <RadioButtons x:Name="ThemeSelector" SelectionChanged="ThemeSelector_SelectionChanged">
                    <RadioButton Content="Use System Setting" Tag="0"/>
                    <RadioButton Content="Light" Tag="1"/>
                    <RadioButton Content="Dark" Tag="2"/>
                </RadioButtons>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- About Section -->
            <StackPanel Spacing="10">
                <TextBlock Text="About JakeyTTS" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="JakeyTTS Voice Engine" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="by abdldavid" FontSize="14" Opacity="0.8" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AppVersionString}" FontSize="14" Margin="0,10,0,0" Opacity="0.8"/>
                        <TextBlock Text="Powered by Kokoro v1.0" FontSize="14" Opacity="0.8"/>
                        <TextBlock Text="© 2026 Developer Edition" FontSize="12" Margin="0,10,0,0" Opacity="0.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Backup & Restore Section -->
            <StackPanel Spacing="15">
                <TextBlock Text="Backup &amp; Restore" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>

                <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                         Title="Security Note" 
                         Message="OAuth tokens (Twitch Login) are NEVER included in backups. On a fresh installation, you will need to link your accounts again."/>

                <TextBlock Text="Select items to export/import:" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <StackPanel Spacing="5">
                    <CheckBox x:Name="ChkBackupCommands" Content="Chat Commands" IsChecked="True"/>
                    <CheckBox x:Name="ChkBackupRewards" Content="Custom Rewards" IsChecked="True"/>
                    <CheckBox x:Name="ChkBackupSFX" Content="Sound Effects &amp; Audio Files" IsChecked="True"/>
                    <CheckBox x:Name="ChkBackupMelodies" Content="Custom Melodies" IsChecked="True"/>
                    <CheckBox x:Name="ChkBackupMixedVoices" Content="Mixed Voices" IsChecked="True"/>
                    <CheckBox x:Name="ChkBackupDictionary" Content="Pronunciation Dictionary" IsChecked="True"/>
                </StackPanel>

                <TextBlock Text="Import Mode:" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <RadioButtons x:Name="ImportModeSelector" MaxColumns="2">
                    <RadioButton x:Name="RadioReplace" Content="Replace (Overwrites existing settings)" Tag="replace" IsChecked="True"/>
                    <RadioButton x:Name="RadioCombine" Content="Combine (Adds only new items)" Tag="combine"/>
                </RadioButtons>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                    <Button Click="Export_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Share"/>
                            <TextBlock Text="Export Backup (.zip)"/>
                        </StackPanel>
                    </Button>

                    <Button Click="Import_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Import"/>
                            <TextBlock Text="Restore from Backup"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Danger Zone Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Danger Zone" Foreground="{ThemeResource SystemFillColorCriticalBrush}" 
                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>

                <TextBlock Text="This will remove all Twitch tokens, commands, and custom rewards. This action cannot be undone." 
                           TextWrapping="Wrap" FontSize="14" MaxWidth="500"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                <Button x:Name="ResetBtn" 
                        Content="Restore Factory Defaults" 
                        Style="{StaticResource CriticalButtonStyle}"
                        Click="ResetBtn_Click" 
                        Padding="16,8" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Confirmation Dialog -->
            <ContentDialog x:Name="ConfirmResetDialog"
                           Title="Reset Everything?"
                           PrimaryButtonText="Yes, Reset"
                           CloseButtonText="Cancel"
                           DefaultButton="Close">
                <TextBlock Text="Are you absolutely sure? You will need to re-link your Twitch accounts and re-configure all your commands." 
                           TextWrapping="Wrap"/>
            </ContentDialog>

        </StackPanel>
    </ScrollViewer>
</Page>

