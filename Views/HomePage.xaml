<Page
    x:Class="JakeyTTS.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Add InfoBar at Top -->
        <InfoBar x:Name="ScopesInfoBar" 
                 Severity="Warning"
                 Title="Action Required"
                 Message="Twitch permissions have been updated to support Subscriptions and Goals. Please re-connect your Broadcaster (and Bot) accounts in Settings."
                 IsOpen="False"
                 IsClosable="False"
                 VerticalAlignment="Top"
                 Margin="20">
            <InfoBar.ActionButton>
                <Button Content="Go to Settings" Click="GoToSettings_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="25">

            <!-- App Icon & Title -->
            <StackPanel Spacing="15" HorizontalAlignment="Center">
                <!-- Swapped FontIcon for Image -->
                <Image Source="ms-appx:///app.ico" 
                       Width="128" 
                       Height="128" 
                       HorizontalAlignment="Center"
                       Stretch="Uniform"/>

                <TextBlock Text="JakeyTTS" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="by abdldavid"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- State 1: Not Configured -->
            <Button x:Name="ConfigureBtn" Click="ConfigureBtn_Click" 
                    Visibility="Collapsed" Padding="40,14" 
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Setting"/>
                    <TextBlock Text="Configure App" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- State 2: Configured but Stopped -->
            <Button x:Name="StartBtn" Click="ServiceToggle_Click" 
                    Visibility="Collapsed" Padding="40,14" 
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Play"/>
                    <TextBlock Text="Start Service" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- State 3: Running -->
            <Button x:Name="StopBtn" Click="ServiceToggle_Click" 
                    Visibility="Collapsed" Padding="40,14"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Stop"/>
                    <TextBlock Text="Stop Service" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Page>
